{minimum_otp_vsn, "27"}.
{erl_opts, [debug_info, warnings_as_errors]}.
{deps, [{gun, "2.7.0"}]}.
{project_plugins, [{erlfmt, "1.8.0"}, {rebar3_lint, "6.0.0"}]}.
{erlfmt, [
    write,
    {print_width, 100},
    {files, ["{src,test}/*.{erl,hrl,app.src}", "rebar.config", "elvis.config"]}
]}.
{profiles, [
    {integration, [
        {erl_opts, [{d, 'BEAMLET_INTEGRATION'}]},
        {deps, [{brod, "4.6.3"}, {epgsql, "4.8.0"}, {eredis, "1.7.1"}, {erlcloud, "3.8.3"}]}
    ]}
]}.
{dialyzer, [{plt_location, local}, {base_plt_location, local}]}.
