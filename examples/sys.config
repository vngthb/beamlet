[
    {beamlet, [
        {config, #{
            session => #{timeout => 120000, ryuk => true, bind_ip => <<"127.0.0.1">>},
            container => #{pull_policy => missing, labels => #{<<"project">> => <<"example">>}},
            presets => #{
                postgres => #{username => <<"tester">>, password => <<"test-secret">>},
                kafka => #{topics => [<<"events">>]},
                moto => #{region => <<"us-east-1">>}
            },
            recipes => #{
                <<"app_db">> => #{kind => postgres, database => <<"orders_test">>},
                <<"cache">> => #{kind => redis, timeout => 30000},
                <<"aws_mock">> => #{kind => moto},
                <<"helper">> => #{
                    kind => generic,
                    image => <<"alpine:3.21.3">>,
                    command => [<<"sleep">>, <<"300">>]
                },
                <<"kafka_browser">> => #{kind => kafka_ui},
                <<"dynamo_browser">> => #{kind => dynamodb_ui}
            }
        }}
    ]}
].
